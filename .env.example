# scripts/setup.ps1 generates a token here when creating .env.
FULLREMOTE_TOKEN=
FULLREMOTE_HOST=127.0.0.1
FULLREMOTE_PORT=8765

# Required when HOST=0.0.0.0 or ::. Use the hostname/IP as seen by the client.
# FULLREMOTE_ALLOWED_HOSTS=windows-vm:8765,192.168.1.50:8765
# FULLREMOTE_ALLOWED_ORIGINS=https://your-client.example

# Defaults: current working directory, then WORKSPACE/.fullremote for job logs.
# FULLREMOTE_WORKSPACE=C:/work
# FULLREMOTE_DATA_DIR=C:/work/.fullremote

FULLREMOTE_MAX_JOBS=8
FULLREMOTE_MAX_INLINE_BYTES=1048576
FULLREMOTE_MAX_UPLOAD_BYTES=1073741824
FULLREMOTE_MAX_LOG_BYTES=8388608
